rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /data/credits {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Suite-wide System Config Alignment
    match /system_config/{document=**} {
      allow read: if true; 
    }
  }
}
